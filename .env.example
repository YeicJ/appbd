# Copia este archivo como .env y llena tus datos (el .env NO se sube a GitHub)

# SQL Server
SQLSERVER_SERVIDOR=localhost
SQLSERVER_BASE=protcivil_db
SQLSERVER_USUARIO=sa
SQLSERVER_CONTRASENA=
# Pon "si" para entrar con la cuenta de Windows (sin usuario ni contraseña)
SQLSERVER_WINDOWS_AUTH=no

# PostgreSQL
PG_SERVIDOR=localhost
PG_PUERTO=5432
PG_BASE=protcivil_db
PG_USUARIO=postgres
PG_CONTRASENA=
